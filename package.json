{
  "name": "agent-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "手机遥控本机 tmux 里的 coding agent（Claude Code / Codex），以 pane_id 为绑定单位",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "agent-remote": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
