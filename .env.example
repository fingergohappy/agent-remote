# 复制到 ~/.agent-remote/.env（chmod 600）

# ── 必填 ──────────────────────────────────────────────────────────────────────
# BotFather 拿到的 token（独立 Bot，别和 Echo/Hermes 共用 —— D2）
TELEGRAM_BOT_TOKEN=
# 允许使用的 Telegram user id，逗号分隔
ALLOWED_USERS=
# hook 与服务之间的 HMAC 密钥：openssl rand -hex 32
INGRESS_SECRET=

# ── 可选 ──────────────────────────────────────────────────────────────────────
# 限定只在这些 chat 里工作（留空 = 不限制，仍受 ALLOWED_USERS 约束）
#ALLOWED_CHATS=

# AGENT_REMOTE_HOME 只能作为环境变量设置（这个文件的位置就由它决定）
#INGRESS_HOST=127.0.0.1
#INGRESS_PORT=8787

# 只扫描这些 tmux session（留空 = 全部）
#SESSION_ALLOWLIST=agent,ibnk,soc,ops,hermes

# 推送策略（D14：绑定后默认全量转播）
#DEFAULT_NOTIFY_LEVEL=verbose          # off | important | verbose
#MIRROR_INTERVAL_MS=20000              # transcript 镜像的兜底轮询间隔（主路径是 hook 触发 + fs.watch）
#QUIET_WHEN_TERMINAL_ACTIVE=false      # 开了才会在人坐在终端前时压制 completed/output
#TERMINAL_ACTIVE_WINDOW_SEC=300
#TELEGRAM_ORIGIN_WINDOW_SEC=900        # TG 发过指令后多久内的事件算「手机发起」

# 历史
#HISTORY_DEFAULT_LIMIT=30
#SYNC_HISTORY_ON_BIND=false            # 绑定后自动拉一次历史

# 解绑后自动关闭话题（保留历史，不删除）
#CLOSE_TOPIC_ON_UNBIND=true

# 授权按钮等待时长（超时后 agent 退回本机 TUI 自己的权限流程）
#DECISION_TIMEOUT_SEC=90

# 发送行为
#ACK_ON_SEND=false                     # 每条消息回一个 👌
#SEND_ENTER_DELAY_MS=150
#SEND_BRACKETED_PASTE=true             # 多行文本用括号粘贴，避免 TUI 逐行提交

#LOG_LEVEL=info                        # debug | info | warn | error
